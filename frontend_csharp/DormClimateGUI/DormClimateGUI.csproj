  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="ScottPlot.WinForms" Version="5.1.57" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\backend_csharp\backend_csharp.csproj" />
  </ItemGroup>

</Project>